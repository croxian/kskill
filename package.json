{
  "name": "seat-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "영화관 빈좌석 알리미 — 롯데시네마 어댑터와 좌석 판정 코어",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixture": "node scripts/make-fixture.mjs",
    "watch": "tsx --env-file-if-exists=.env src/main.ts",
    "probe": "tsx scripts/probe-hold.ts",
    "cgv": "tsx scripts/cgv-raw.ts",
    "browser": "playwright install chromium",
    "login": "playwright open --user-data-dir=.profile https://www.lottecinema.co.kr",
    "login:cgv": "playwright open --user-data-dir=.profile https://www.cgv.co.kr",
    "record": "playwright codegen --user-data-dir=.profile https://www.lottecinema.co.kr",
    "record:cgv": "playwright codegen --user-data-dir=.profile https://www.cgv.co.kr"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.23.11",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
