# @BotFather 에서 /newbot 으로 발급
TG_TOKEN=123456789:AA...

# 봇에게 아무 메시지나 보낸 뒤 아래로 확인
#   curl "https://api.telegram.org/bot$TG_TOKEN/getUpdates"
# 응답의 result[0].message.chat.id
TG_CHAT_ID=987654321

# ── 좌석 확보(hold 모드)에서만 쓰는 것들 ─────────────────────────
#
# (선택) 롯데시네마 자격증명.
#
# 평소에는 .profile 세션이 유지되므로 로그인이 거의 일어나지 않는다.
# 이 값은 **세션이 죽었을 때만** 쓰인다 — 며칠에 한 번 있을까 말까다.
# 비워두면 세션이 풀렸을 때 텔레그램으로 알리기만 한다.
#
# 계정 잠금의 실제 위험은 자동 로그인 자체가 아니라 빈도다. 이 구조를
# 유지하는 한 위험은 낮지만, 계정에 2단계 인증이 걸려 있으면 동작하지 않는다.
# 이 파일은 .gitignore 에 있고, 값은 셸 인자나 로그에 절대 싣지 않는다.
LOTTE_ID=
LOTTE_PW=

# (선택) 세션 점검 주기(분). 기본 30
SESSION_CHECK_MIN=30

# (선택) 스스로 정한 홀드 상한(초). 롯데는 화면에 카운트다운이 없어
# 서버 만료를 알 수 없다. 실측 5분 안팎. 기본 300
HOLD_SECONDS=300

# (선택) 회차 좌석선택 화면 딥링크 템플릿.
# 예매 화면에서 좌석 선택 단계까지 간 뒤 주소창 URL 을 복사해,
# 회차마다 달라지는 조각을 자리표시자로 바꿔 넣는다.
# 쓸 수 있는 것: {theaterId} {screenId} {playDate} {playDateDash} {playSequence} {movieId}
# 비워두면 예매 첫 화면으로 보낸다.
LOTTE_DEEPLINK=
